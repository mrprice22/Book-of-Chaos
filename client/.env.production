# Build-time configuration for the hosted reader. Vite inlines VITE_* into the
# bundle at build time, so these must be set when `npm run build` runs — Cloudflare's
# runtime environment variables cannot reach a static bundle and would do nothing.
#
# Committed on purpose. Neither value is a secret: a public hostname and a database
# name that is already visible in every client that connects. Keeping them in the
# repo means the build behaves identically here and on Cloudflare, with no dashboard
# setting to drift out of sync or to forget when the project is rebuilt.
#
# wss:// and not ws://. The page is served over HTTPS, and a ws:// connection from an
# HTTPS page is mixed content that the browser blocks outright.
VITE_SPACETIME_URI=wss://maincloud.spacetimedb.com
VITE_SPACETIME_DB_NAME=book-of-chaos-83i7y
