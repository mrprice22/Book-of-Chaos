# Dev container home — toolchains, caches, shell state
.devhome/

# Rust
target/
**/*.rs.bk

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# Scratch trees left behind if generate-bindings.sh is interrupted mid-swap. They
# live under client/src, so without this an abandoned one would be type-checked and
# committed as a second copy of the bindings.
client/src/module_bindings.new/
client/src/module_bindings.old/

# Playwright
playwright-report/
test-results/

# SpacetimeDB local state and identity material
.spacetime/
*.identity
*.token

# Environment / secrets
.env
.env.*
!.env.example
# The hosted reader's build-time config. Not secrets — a public wss:// hostname and a
# database name every connecting client already reveals. Committed so that the build
# is reproducible off a clean clone instead of depending on dashboard settings.
!client/.env.production

# Editors / OS
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code personal overrides (project settings.json IS committed)
.claude/settings.local.json
